# ── API ─────────────────────────────────────────────────────────────
# MongoDB connection (local or MongoDB Atlas free tier)
MONGODB_URI=mongodb://localhost:27017/interview-prep-kit

# Express session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed CORS origins (frontend URLs)
CLIENT_ORIGIN=http://localhost:3001

# PORT for the Express backend
PORT=4000

# ── LLM (OpenAI-compatible API — default: DeepSeek) ────────────────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-chat

# Max LLM retries on rate-limit / transient failure (with exponential backoff)
LLM_MAX_RETRIES=4

# ── Pipeline tuning ────────────────────────────────────────────────
# Max coverage passes (first draft + gap-filling passes)
MAX_COVERAGE_PASSES=3

# Max pages to fetch during a crawl
CRAWL_MAX_PAGES=6

# Allow fetching localhost/private addresses.
# true for local dev & the batch evaluator (test companies run on localhost).
# MUST be false in production.
ALLOW_PRIVATE_URLS=true

# ── Web (Next.js) ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
