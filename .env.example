# =============================================================================
# Interview Prep Kit — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The batch command (`npm run evaluate`) and the API both read these.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# Port the Express API listens on.
PORT=4000
# Comma-separated list of allowed browser origins for CORS.
WEB_ORIGIN=http://localhost:3000

# --- Database ----------------------------------------------------------------
# MongoDB connection string. Use the free MongoDB Atlas tier in the cloud,
# or mongodb://127.0.0.1:27017/interview-prep-kit locally.
MONGODB_URI=mongodb://127.0.0.1:27017/interview-prep-kit

# --- Auth --------------------------------------------------------------------
# 32+ random bytes, e.g. `openssl rand -hex 32`. Signing key for session JWTs.
JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime (jwt expiresIn syntax).
JWT_EXPIRES_IN=7d
# Name of the httpOnly session cookie.
SESSION_COOKIE_NAME=ipk_session

# --- LLM provider (any OpenAI-compatible free tier) --------------------------
# Supported: groq | openai-compatible | mock
# `mock` runs the pipeline deterministically with no network calls (used by tests).
LLM_PROVIDER=groq
# API key for the chosen provider (Groq / OpenRouter / Gemini-compatible / etc.).
LLM_API_KEY=
# Model id for the provider. Examples:
#   groq:              llama-3.3-70b-versatile
#   openrouter (free): meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL=llama-3.3-70b-versatile
# Base URL for the OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Max simultaneous in-flight model calls (keeps us under tokens-per-minute).
LLM_MAX_CONCURRENCY=2
# Retries per model call on 429/5xx/timeout, with exponential backoff + jitter.
LLM_MAX_RETRIES=5
# Hard ceiling on output tokens per call.
LLM_MAX_OUTPUT_TOKENS=4000

# --- Retrieval ---------------------------------------------------------------
# Per-request network timeout.
FETCH_TIMEOUT_MS=10000
# Maximum bytes read from a single page (guards against huge responses).
FETCH_MAX_BYTES=2000000
# Maximum pages crawled per company site.
CRAWL_MAX_PAGES=12
# Max concurrent outbound page fetches.
FETCH_CONCURRENCY=4
# Allow crawling private/loopback hosts. MUST be false in production; set true
# only when testing with local fixture sites (e.g. http://localhost:8099).
ALLOW_PRIVATE_HOSTS=false
# Optional. Provide a contact string for the crawler User-Agent.
CRAWLER_USER_AGENT=InterviewPrepKitBot/1.0 (+https://github.com/your-handle/interview-prep-kit)

# --- Frontend (exposed to the browser) ---------------------------------------
# Base URL of the API as seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000
